# ─────────────────────────────────────────────────────────────────────────────
# FlowTrack — Environment Configuration
#
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=flowtrack
POSTGRES_USER=flowtrack
POSTGRES_PASSWORD=change_me_please

# Full connection URL (used by the Go server via GORM)
DATABASE_URL=postgres://flowtrack:change_me_please@postgres:5432/flowtrack?sslmode=disable

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_random_64_char_hex_string
API_SECRET=replace_with_another_random_64_char_hex_string

# ── Server ────────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# Comma-separated list of allowed CORS origins
# Use * for development, set explicit origins in production
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Public URL of the web dashboard (used by server for redirect links)
WEB_URL=http://localhost

# ── Features ──────────────────────────────────────────────────────────────────
# Set to "false" to disable new user registration (invite-only / private instance)
REGISTRATION_ENABLED=true

# Set to "false" to hide leaderboard from all users
LEADERBOARD_ENABLED=true

# ── Agent ─────────────────────────────────────────────────────────────────────
# URL of the FlowTrack server the agent syncs to
FLOWTRACK_SERVER_URL=http://localhost:8080
# How often to sync activity data (seconds)
FLOWTRACK_SYNC_INTERVAL=60
# How often to sample the active window (seconds)
FLOWTRACK_POLL_INTERVAL=5

# ── Nginx / Reverse Proxy (production only) ───────────────────────────────────
# Set this to your public domain when deploying behind Nginx/Caddy/Cloudflare
# DOMAIN=flowtrack.example.com
