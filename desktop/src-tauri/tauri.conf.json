{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowTrack",
  "version": "1.0.0",
  "identifier": "app.flowtrack.desktop",
  "build": {
    "beforeDevCommand":   "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl":             "http://localhost:1420",
    "frontendDist":       "../dist"
  },
  "app": {
    "windows": [
      {
        "title":      "FlowTrack",
        "width":      1100,
        "height":     720,
        "minWidth":   800,
        "minHeight":  600,
        "resizable":  true,
        "center":     true,
        "decorations": true,
        "visible":    false,
        "label":      "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' http: https:"
    },
    "trayIcon": {
      "iconPath":    "icons/icon.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active":      true,
    "targets":     "all",
    "icon":        ["icons/icon.png", "icons/icon.ico"],
    "category":    "Utility",
    "copyright":   "© 2026 FlowTrack Contributors",
    "shortDescription": "Application time tracker",
    "longDescription":  "FlowTrack is a lightweight native application time tracker with leaderboards and self-hosted server support.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libayatana-appindicator3-1"]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "signingIdentity":  null,
      "minimumSystemVersion": "10.15",
      "entitlements":    null
    },
    "windows": {
      "wix": {},
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    }
  },
  "plugins": {
    "autostart": {
      "windows": "TaskScheduler"
    },
    "single-instance": {}
  }
}
